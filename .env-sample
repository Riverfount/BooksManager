POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Segredo que assina e valida os tokens JWT (RF08, RNF10): obrigatório, com ao menos 32 bytes.
# A aplicação não sobe sem ele. Gere um com: openssl rand -base64 48
APP_JWT_SECRET=
# Origem(ns) do front-end liberada(s) no CORS, separadas por vírgula (RNF09)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Administrador inicial (RF08): criado na inicialização só se não houver nenhum usuário.
# Preencha as duas; a senha fica só aqui (no ambiente), nunca em migração nem em arquivo versionado.
APP_ADMIN_LOGIN=
APP_ADMIN_PASSWORD=
