POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Segredo que assina e valida os tokens JWT (RF08, RNF10): obrigatório, com ao menos 32 bytes.
# A aplicação não sobe sem ele. Gere um com: openssl rand -base64 48
APP_JWT_SECRET=
# Origem(ns) do front-end liberada(s) no CORS, separadas por vírgula (RNF09)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Administrador inicial (RF08): criado na inicialização só se não houver nenhum usuário.
# Preencha as duas; a senha fica só aqui (no ambiente), nunca em migração nem em arquivo versionado.
APP_ADMIN_LOGIN=
APP_ADMIN_PASSWORD=
# E-mail (RF28): desligado por padrão, nada é enviado. Para ligar, APP_MAIL_ENABLED=true com o servidor SMTP e o
# remetente; usuário e senha só se o servidor pedir. Em desenvolvimento, um servidor de teste (MailHog, por exemplo)
# em localhost:1025 com APP_MAIL_STARTTLS=false evita mandar e-mail de verdade.
APP_MAIL_ENABLED=false
APP_MAIL_HOST=
APP_MAIL_PORT=587
APP_MAIL_USERNAME=
APP_MAIL_PASSWORD=
APP_MAIL_FROM=
APP_MAIL_STARTTLS=true
