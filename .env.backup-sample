# Variables of the backup scripts (deploy/backup). Copy to .env.backup, fill it in and never commit it:
#   cp .env.backup-sample .env.backup && chmod 600 .env.backup
# There is no real secret in this file. The guide is docs/implantacao.md, section 7. The environment wins over the file.

# Where the backups are kept on the server (relative to the repository), how many daily files stay, and the prefix.
BACKUP_DIR=backups
BACKUP_KEEP_LOCAL=14
BACKUP_PREFIX=booksmanager

# The rclone remote that receives the copy, as "remote:folder". It MUST be a "crypt" remote (the backup carries personal
# data, minors included): the script refuses a remote that is not. Empty: the backup stays on the server only.
BACKUP_RCLONE_REMOTE=
# Days that the copies stay on the remote.
BACKUP_REMOTE_KEEP_DAYS=90

# Monitoring URLs (Healthchecks.io style: the URL for success, the URL + /fail for failure). A missing ping is the alert
# when the cron job did not even run. Empty: nobody is called, the log is the only trace.
BACKUP_PING_URL=
BACKUP_RESTORE_PING_URL=
