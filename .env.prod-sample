# Variables of the production stack (compose.prod.yaml). Copy to .env.prod, fill it in and never commit it:
#   cp .env.prod-sample .env.prod && chmod 600 .env.prod
# There is no real secret in this file. The guide is docs/implantacao.md.

# Public name of the server (no http://), the one the certificate is issued for. It must point to this server.
DOMAIN=biblioteca.example.com

# Where the certificate is. Either a folder of the server that has live/<DOMAIN>/fullchain.pem and privkey.pem
# (certificates you mount), or the name of the volume that certbot fills (the default: letsencrypt).
LETSENCRYPT_DIR=./certs

# Database. Use a long random password: openssl rand -base64 24
POSTGRES_DB=biblioteca
POSTGRES_USER=biblioteca
POSTGRES_PASSWORD=

# Secret that signs the tokens (RF08, RNF10): at least 32 bytes, and the API does not start without it.
# Generate one with: openssl rand -base64 48
APP_JWT_SECRET=

# Origin of the front-end allowed by CORS (RNF09), with https and no slash at the end.
APP_CORS_ALLOWED_ORIGINS=https://biblioteca.example.com

# First administrator (RF08): created at startup only if there is no user at all. Fill both, and take the password
# out of this file after the first start if you like: it is not read again once there is a user.
APP_ADMIN_LOGIN=
APP_ADMIN_PASSWORD=

# E-mail notifications (RF28): off by default, nothing is sent. To turn it on, set APP_MAIL_ENABLED=true with the SMTP
# server of your provider and the sender address; username and password only if the server asks for them.
APP_MAIL_ENABLED=false
APP_MAIL_HOST=
APP_MAIL_PORT=587
APP_MAIL_USERNAME=
APP_MAIL_PASSWORD=
APP_MAIL_FROM=
APP_MAIL_STARTTLS=true

# Version of the image that runs. Each deployment builds a new tag (see "Atualização" in the guide); going back is
# going back to a previous tag.
IMAGE_TAG=latest
