# Nginx in front of the API (RNF12). The image replaces ${DOMAIN} when it starts (the other $ variables are
# Nginx's own and stay as they are). The certificate is read from the path of certbot's layout.

# Port 80: nothing is served in clear text, everything goes to https.
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    location / {
        return 301 https://$host$request_uri;
    }
}

# Port 443: ends the TLS and passes the requests to the API on the private network.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # HSTS: the browsers go to https by themselves for a year. Not "preload" and not "includeSubDomains" on purpose:
    # they are hard to undo, and nothing here asks for them.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    # The API takes small JSON bodies.
    client_max_body_size 1m;

    # Do not say which version of Nginx this is.
    server_tokens off;

    location / {
        proxy_pass http://app:8080;
        proxy_http_version 1.1;

        # The API also sends these (Spring Security does, once it knows the connection is https). The proxy is the
        # one that ends the TLS, so its headers are the ones that count: hide the API's copies, or the browser
        # would get each twice (and an HSTS with includeSubDomains that is not the one chosen above).
        proxy_hide_header Strict-Transport-Security;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;

        # These are SET here, never passed on from the client, so a client cannot forge them. The API trusts them
        # because they come from this proxy, on the private network (application-prod.properties).
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  $server_port;

        proxy_connect_timeout 5s;
        proxy_read_timeout    60s;
    }
}
