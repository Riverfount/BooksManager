# Nginx in front of the API and of the front-end (RNF12). It ends the TLS and sends what the API answers (see the
# location with the regular expression below) to the API, and everything else to the front-end, on the SAME origin: the
# front-end calls /api/... with relative URLs and the refresh token is a SameSite=Strict cookie. The image replaces
# ${DOMAIN} when it starts (the other $ variables are Nginx's own and stay as they are). The certificate is read from
# the path of certbot's layout.

# Limit of the login attempts (RNF13, RF27). Every refused login is written to the audit trail, and the API has no rate
# limit of its own, so without this anyone could fill the table. The key is the client address, and only for
# POST /api/v1/auth/login: for any other request it is empty, and a request with an empty key is not counted. The
# limit is then set once, on the single location of the API (below), with no copy of the proxy settings. $uri is the path already
# decoded and normalized by Nginx, so "//api/v1/auth/login" and "%2e" tricks do not go around it. 5 per minute with a
# burst of 5: a person who mistypes the password a few times is not stopped; a script is.
map "$request_method $uri" $login_limit_key {
    default                      "";
    "POST /api/v1/auth/login"    $binary_remote_addr;
}
limit_req_zone $login_limit_key zone=login:10m rate=5r/m;

# Limit of the public routes of the access of the readers (Phase 6, RNF31): accepting an invitation, asking for a new
# password and choosing it. They are open to anyone who has a link or an e-mail address, and "forgot-password" sends an
# e-mail each time, so they are counted per client address, with the same 5 per minute and burst of 5 as the login. A
# request to any other route has an empty key and is not counted. The API also limits the "forgot-password" requests per
# e-mail (3 per hour), which the Nginx cannot see; this one is the first barrier, by address.
map "$request_method $uri" $reader_access_limit_key {
    default                                  "";
    "POST /api/v1/auth/accept-invitation"    $binary_remote_addr;
    "POST /api/v1/auth/forgot-password"      $binary_remote_addr;
    "POST /api/v1/auth/reset-password"       $binary_remote_addr;
}
limit_req_zone $reader_access_limit_key zone=reader_access:10m rate=5r/m;

# Port 80: nothing is served in clear text, everything goes to https.
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    location / {
        return 301 https://$host$request_uri;
    }
}

# Port 443: ends the TLS and passes the requests to the API on the private network.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # HSTS: the browsers go to https by themselves for a year. Not "preload" and not "includeSubDomains" on purpose:
    # they are hard to undo, and nothing here asks for them.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    # Docker's own DNS, which answers for the names of the services ("app", "web") on the private network. The two
    # proxy_pass below use a variable, so Nginx asks it again every few seconds instead of resolving the name once, at
    # start. An update recreates only what changed (the Nginx stays), and a recreated container may get ANOTHER address:
    # a name resolved only at the start would keep the old one and answer 504 until the Nginx restarted. The variable also
    # lets the Nginx start before the other containers, and an upstream that is down is a 502/504, not a Nginx that
    # does not start.
    resolver 127.0.0.11 valid=5s ipv6=off;

    # What goes over the limit gets 429 (not the 503 of the default) and the log says "warn", not "error".
    limit_req_status 429;
    limit_req_log_level warn;

    # The API takes small JSON bodies.
    client_max_body_size 1m;

    # Do not say which version of Nginx this is.
    server_tokens off;

    # The answer to a request over a limit (the login and the public routes of the readers): the same format as the errors of the API (ProblemDetail, RFC 9457). An
    # "add_header" in a location replaces the ones of the server block, so the security headers are repeated here.
    error_page 429 = @too_many_requests;
    location @too_many_requests {
        default_type application/problem+json;
        add_header Retry-After 12 always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        return 429 '{"type":"about:blank","title":"Too Many Requests","status":429,"detail":"Muitas tentativas. Aguarde alguns segundos e tente de novo."}';
    }

    # Everything the API answers lives under these prefixes: /api/ (the business routes), /actuator/ (the health check),
    # /v3/ (the OpenAPI document) and /swagger-ui (the documentation page and its files, including /swagger-ui.html). It
    # is ONE location, so the proxy settings and the two limits are written once. Anything else is the front-end. This is
    # exactly what reached the API before the front-end was served here, and nothing more: a path that is not here never
    # reaches the API. The match is made on the normalized path ($uri), so "//api/..." and "/%61pi/..." do not go around
    # it (nor around the limits).
    location ~ ^/(api|actuator|v3|swagger-ui)(/|\.html$|$) {
        # Only the login and the public routes of the readers are counted (see the maps above).
        limit_req zone=login burst=5 nodelay;
        limit_req zone=reader_access burst=5 nodelay;

        # A variable, not the name in the proxy_pass (see the resolver above). With no URI after it, the request goes on
        # exactly as it came, as before.
        set $app_upstream http://app:8080;
        proxy_pass $app_upstream;
        proxy_http_version 1.1;

        # The API also sends these (Spring Security does, once it knows the connection is https). The proxy is the
        # one that ends the TLS, so its headers are the ones that count: hide the API's copies, or the browser
        # would get each twice (and an HSTS with includeSubDomains that is not the one chosen above).
        proxy_hide_header Strict-Transport-Security;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;

        # These are SET here, never passed on from the client, so a client cannot forge them. The API trusts them
        # because they come from this proxy, on the private network (application-prod.properties).
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  $server_port;

        proxy_connect_timeout 5s;
        proxy_read_timeout    60s;
    }

    # The front-end: the static files of the single-page app, served by its own image (Riverfount/booksmanager-web) on the
    # private network, which does the fallback to index.html and the cache of the hashed files. Nothing is counted
    # against the limits here. The image sends no security headers, so the ones of this server block (HSTS, nosniff,
    # X-Frame-Options, Referrer-Policy) are the only ones, and this location adds none of its own (it would replace them).
    # The Host is the public one, and so are the forwarded headers, for the same reason as above.
    location / {
        set $web_upstream http://web:8080;
        proxy_pass $web_upstream;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  $server_port;

        proxy_connect_timeout 5s;
        proxy_read_timeout    30s;
    }
}
